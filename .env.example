# Use "square" for live orders, "sample" for demo data, or "auto" to use
# Square when a token is present and sample data otherwise.
ORDER_SOURCE=square

# Production credentials from the Square Developer Console. Keep this file out
# of Git. A personal access token is appropriate for this single-account app.
SQUARE_ACCESS_TOKEN=

# Optional when the account has one active location. Run:
#   uv run pizzeria-square-check
# to list valid location IDs.
SQUARE_LOCATION_ID=

SQUARE_ENVIRONMENT=production
SQUARE_API_VERSION=2026-07-15
SQUARE_ORDER_LOOKBACK_DAYS=60
SQUARE_AUTO_REFRESH_SECONDS=10
SQUARE_INCREMENTAL_OVERLAP_SECONDS=120
SQUARE_TIMEOUT_SECONDS=20
SQUARE_VIP_GROUP_NAME=Pizzeria Mari VIP

SERVICE_TIMEZONE=America/New_York

# Optional dashboard authentication. Set both values to enable the sign-in page.
# A successful sign-in is remembered in this browser for 30 days. Use a long,
# unique password and expose the dashboard over HTTPS rather than forwarding
# Flask directly to the public Internet.
DASHBOARD_AUTH_USERNAME=
DASHBOARD_AUTH_PASSWORD=
DASHBOARD_AUTH_REMEMBER_DAYS=30

# Persistent brute-force protection. Five failed attempts from one client in a
# 15-minute window trigger an escalating 1-to-15-minute lockout. A higher shared
# threshold also limits distributed attempts against the single dashboard login.
DASHBOARD_AUTH_ATTEMPT_WINDOW_MINUTES=15
DASHBOARD_AUTH_MAX_ATTEMPTS_PER_CLIENT=5
DASHBOARD_AUTH_MAX_ATTEMPTS_GLOBAL=50
DASHBOARD_AUTH_LOCKOUT_BASE_SECONDS=60
DASHBOARD_AUTH_LOCKOUT_MAX_MINUTES=15

# Keep this true for the normal HTTPS deployment. Set it to false only when
# intentionally testing authenticated access over plain HTTP on a trusted LAN.
DASHBOARD_SESSION_COOKIE_SECURE=true

# Optional comma-separated hostnames accepted by Flask once you know the public
# hostname, for example: dashboard.example.com,localhost,127.0.0.1
DASHBOARD_TRUSTED_HOSTS=

# Enable only after the public dashboard is served exclusively over HTTPS.
DASHBOARD_HSTS=true

# Optional Flask signing key. If omitted, the dashboard automatically creates a
# stable private key in data/.dashboard-secret-key so remembered sign-ins survive
# service restarts. The data directory must remain persistent across deployments.
SECRET_KEY=
PIZZA_CAPACITY_PER_WINDOW=3
ORDER_PREP_BUFFER_MINUTES=20

# Match these to category names in the Square item library. Name-based fallbacks
# are used if catalog details cannot be loaded.
# Comma-separated values may contain spaces. These defaults match Pizzeria
# Mari's current Square catalog; add or remove names as the menu evolves.
SQUARE_PIZZA_CATEGORY_NAMES=Traditional Pies,Mari Pies,Seasonal Special Pies,Pizza,Pizzas
SQUARE_HIDDEN_CATEGORY_NAMES=Drink,Drinks,Beverage,Beverages
SQUARE_PIZZA_ITEM_KEYWORDS=pizza,pie
SQUARE_SLICE_CATEGORY_NAMES=Slice,Slices
SQUARE_SLICE_ITEM_KEYWORDS=slice,slices
SQUARE_HIDDEN_ITEM_KEYWORDS=drink,beverage,coke,soda,water
SQUARE_SALAD_MODIFIER_KEYWORDS=salad
SQUARE_SIDE_MODIFIER_KEYWORDS=side
SQUARE_COOKIE_MODIFIER_KEYWORDS=cookie
# Main-order item categories used by the custom online ordering portal.
SQUARE_SALAD_CATEGORY_NAMES=Salad,Salads
SQUARE_SALAD_ITEM_KEYWORDS=salad
SQUARE_SIDE_CATEGORY_NAMES=Side,Sides
SQUARE_SIDE_ITEM_KEYWORDS=side
SQUARE_DESSERT_CATEGORY_NAMES=Dessert,Desserts
SQUARE_DESSERT_ITEM_KEYWORDS=dessert
SQUARE_MERCH_CATEGORY_NAMES=Merch,Merchandise
SQUARE_MERCH_ITEM_KEYWORDS=merch,shirt,hat,tote
SQUARE_COOKIE_CATEGORY_NAMES=Cookie,Cookies
SQUARE_COOKIE_ITEM_KEYWORDS=cookie
# Rebuildable customer history
CUSTOMER_HISTORY_START_DATE=2025-01-01
CUSTOMER_HISTORY_REFRESH_SECONDS=60
CUSTOMER_HISTORY_OVERLAP_HOURS=48
